// superclasse; `alunos`, `professores` e `funcionarios_administrativos` são
// subclasses (Estratégia 2, Seção 8.7 da aula — cada subclasse tem PK
// própria que também é FK única para a superclasse, mesmo valor de id_pessoa).

Table pessoas {
  id_pessoa bigint [pk]
  nome varchar
}

