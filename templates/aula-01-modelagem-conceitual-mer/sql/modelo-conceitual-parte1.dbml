// precisa conter, no mínimo, as tabelas pacientes, medicos, especialidades,
// consultas e prontuarios, com PK/FK corretas (Regras 5 e 6) e um `Ref:`
// para cada relacionamento, com a cardinalidade certa. Pense com cuidado em
// dois pontos (ver enunciado): Médico × Especialidade, e Consulta × Prontuário.

Table pacientes {
  id_paciente bigint [pk]
  nome varchar
}

