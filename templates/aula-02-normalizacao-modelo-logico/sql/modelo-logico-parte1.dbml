// precisa conter, no mínimo, clientes, veiculos, mecanicos, servicos,
// ordens_servico e itens_ordem_servico, com PK/FK corretas e cardinalidades
// certas. Lembre-se: toda PK é id_tabela (Regra 5); mantenha placa/cpf/
// matricula como atributos comuns ([unique]), não como chave primária.

Table clientes {
  id_cliente bigint [pk]
  nome varchar
}

