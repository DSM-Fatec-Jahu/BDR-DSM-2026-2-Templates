{
  "name": "BDR — Aula 03 — SQL e DDL: Definição de Estruturas",
  "dockerComposeFile": "docker-compose.yml",
  "service": "workspace",
  "workspaceFolder": "/workspace/templates/aula-03-sql-ddl-estruturas",

  // A feature "common-utils" foi removida: a imagem
  // mcr.microsoft.com/devcontainers/python já aplica esse mesmo tratamento
  // (usuário non-root, sudo, git) na própria construção da imagem, então a
  // feature era redundante — e o `apt-get update` que ela roda vinha
  // falhando por causa de um repositório do Yarn pré-configurado na variante
  // bullseye da imagem, sem chave GPG válida (NO_PUBKEY 62D54FD4003F6525).

  "customizations": {
    "vscode": {
      "extensions": [
        "cweijan.vscode-mysql-client2",
        "ms-python.python",
        "yzhang.markdown-all-in-one"
      ]
    }
  },

  // `apt-get update` aqui tolera falha (`|| true`): a variante bullseye
  // desta imagem já vem com um repositório do Yarn pré-configurado sem
  // chave GPG válida (NO_PUBKEY 62D54FD4003F6525, mesmo problema descrito
  // no devcontainer.json da Aula 01/02 ao remover a feature "common-utils").
  // Isso faz `apt-get update` retornar código de erro mesmo quando os
  // índices dos repositórios Debian (main/security/updates) — os únicos
  // que interessam aqui — foram baixados com sucesso antes da falha do
  // Yarn. Sem o `|| true`, o `&&` seguinte nunca chegaria a instalar o
  // mariadb-client.
  "postCreateCommand": "sudo apt-get update -y || true && sudo apt-get install -y mariadb-client && bash /workspace/.devcontainer/aula-03-sql-ddl-estruturas/boas-vindas.sh",
  "postAttachCommand": {
    "abrir-enunciado": "code documentacao/enunciado.md || true",
    "abrir-readme": "code README.md || true"
  }
}
