{
  "name": "BDR — Aula 03 — SQL e DDL: Definição de Estruturas",
  "dockerComposeFile": "docker-compose.yml",
  "service": "workspace",
  "workspaceFolder": "/workspace/templates/aula-03-sql-ddl-estruturas",

  // A feature "common-utils" foi removida: a imagem
  // mcr.microsoft.com/devcontainers/python já aplica esse mesmo tratamento
  // (usuário non-root, sudo, git) na própria construção da imagem, então a
  // feature era redundante — e o `apt-get update` que ela roda vinha
  // falhando por causa de um repositório do Yarn pré-configurado na variante
  // bullseye da imagem, sem chave GPG válida (NO_PUBKEY 62D54FD4003F6525).

  "customizations": {
    "vscode": {
      "extensions": [
        "cweijan.vscode-mysql-client2",
        "ms-python.python",
        "yzhang.markdown-all-in-one"
      ]
    }
  },

  "postCreateCommand": "bash /workspace/.devcontainer/aula-03-sql-ddl-estruturas/boas-vindas.sh",
  "postAttachCommand": {
    "abrir-enunciado": "code documentacao/enunciado.md || true",
    "abrir-readme": "code README.md || true"
  }
}
