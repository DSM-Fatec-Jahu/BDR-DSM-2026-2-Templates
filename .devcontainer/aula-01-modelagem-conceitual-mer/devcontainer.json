{
  "name": "BDR — Aula 01 — Modelagem Conceitual (MER)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bullseye",

  // Monta o repositório inteiro (necessário porque tests/regras_avaliacao.py
  // importa de ../../../shared/), mas abre o editor e o terminal já dentro
  // da pasta deste template — o aluno não precisa dar "cd" depois de entrar
  // no Codespace. Mesmo padrão usado pela Aula 03 (ver docker-compose.yml
  // de lá); aqui não há compose, então workspaceMount faz o mesmo papel.
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  "workspaceFolder": "/workspace/templates/aula-01-modelagem-conceitual-mer",

  "customizations": {
    "vscode": {
      "extensions": [
        "bierner.markdown-mermaid",
        "bpruitt-goddard.mermaid-markdown-syntax-highlighting",
        "ms-python.python",
        "yzhang.markdown-all-in-one"
      ],
      "settings": {
        "markdown.preview.breaks": true
      }
    }
  },

  "postCreateCommand": "bash /workspace/.devcontainer/aula-01-modelagem-conceitual-mer/boas-vindas.sh",
  "postAttachCommand": {
    "abrir-enunciado": "code documentacao/enunciado.md || true",
    "abrir-readme": "code README.md || true"
  }
}
